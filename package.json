{
  "name": "longbox",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted physical comic collection tracker.",
  "scripts": {
    "dev": "next dev -p 3210 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -p 3210 -H 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "import:clz": "tsx scripts/import-clz.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "fixture": "node fixtures/generate-csv.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "dotenv": "^17.2.3",
    "next": "^15.5.4",
    "prisma": "^6.16.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
