# Allowlist. The app directory on the box also holds backups and env files.
*

!REVISION
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!next-env.d.ts
!postcss.config.js
!tailwind.config.ts
!.eslintrc.json

!src
!src/**

!public
!public/**

!docker
!docker/**

!scripts
!scripts/**

!fixtures
!fixtures/**

!prisma
!prisma/**

# Dumps, secrets, and local data never enter the image.
*.sql
**/*.sql
.env*
**/.env*
linksnap-*.csv
**/linksnap-*.csv
/backups
/backups/**
/data
/data/**
/covers
/covers/**
node_modules
node_modules/**
.next
.next/**

# prisma migrate deploy reads these. Every other SQL file stays out.
!prisma/migrations
!prisma/migrations/**
!prisma/migrations/**/*.sql
