# Host port published on the ZimaOS box. The app process listens on 3210.
APP_PORT=3210
BIND_ADDRESS=0.0.0.0

POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=longbox

# Inside Compose the host name is `db`. On the host, point this at localhost.
# Placeholder only. Set a real password before starting. There is no default.
DATABASE_URL=postgres://user:CHANGE_ME@db:5432/longbox

TZ=America/Chicago

# Used when Cloudflare Access is not in front of the app.
LONGBOX_USER_EMAIL=cody@localhost

# Load the synthetic 30-issue shelf the first time the database is empty.
# A choice saved in Settings overrides this.
SEED_ON_EMPTY=true

# Encrypts credentials saved in Settings. 32 bytes, base64 or hex.
# Leave unset and the first boot writes longbox-secret.key on the data volume.
# LONGBOX_SECRET_KEY=

# Comic Vine. Leave blank to skip it. Settings can override this.
COMICVINE_API_KEY=

# Metron. Leave blank to skip Metron lookups.
METRON_API_TOKEN=
METRON_USERNAME=
METRON_PASSWORD=
METRON_API_BASE=https://metron.cloud/api

# Share of the Metron day one full re-match may use. The rest stays free for searches.
# METRON_FULL_RUN_SHARE=0.6

# Cover files. Compose sets COVERS_DIR=/data/covers on the longbox_covers volume.
# Leave this unset on the host to use ./data/covers.
# COVERS_DIR=

# Grand Comics Database. Compose does not pass GCD_USERNAME or GCD_PASSWORD.
# Save them on Settings (the password is encrypted). These two are only a host
# fallback, the same way Metron's username and password are. Blank stays
# anonymous (30/hour). A saved pair uses 2,000 requests a day.
GCD_API_BASE=https://www.comics.org
GCD_USERNAME=
GCD_PASSWORD=

# eBay price provider stub. Unused until pricing ships. Do not add PriceCharting.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Shown on Settings → About. Compose passes this into the app.
LONGBOX_COMMIT=dev

# Set to off to stop writing Logs. Unset, or any other value, keeps logging on.
# LONGBOX_LOG=off
